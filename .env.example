# 카카오 REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
# 카카오 클라이언트 시크릿
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here
# 카카오 리다이렉트 URI (기본값: http://localhost)
KAKAO_REDIRECT_URI=http://localhost
# 카카오 리프레시 토큰 (get_kakao_token.py 실행 시 자동 저장)
KAKAO_REFRESH_TOKEN=
# 카카오 액세스 토큰 (get_kakao_token.py 실행 시 자동 저장)
KAKAO_ACCESS_TOKEN=
